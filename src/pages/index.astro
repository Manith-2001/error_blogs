---
import { getCollection } from 'astro:content';
import AmbientBackground from '../components/AmbientBackground.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { ArrowRight } from 'lucide-react';
import { SITE_AUTHOR, SITE_AUTHOR_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 3);

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			url: new URL(Astro.url.pathname, Astro.site).toString(),
		},
		{
			'@type': 'Person',
			name: SITE_AUTHOR,
			url: new URL(SITE_AUTHOR_URL, Astro.site).toString(),
			sameAs: ['https://github.com/Manith-2001'],
		},
		{
			'@type': 'Blog',
			name: SITE_TITLE,
			url: new URL('/blog', Astro.site).toString(),
			blogPost: posts.map((post) => ({
				'@type': 'BlogPosting',
				headline: post.data.title,
				url: new URL(`/blog/${post.id}/`, Astro.site).toString(),
				datePublished: post.data.pubDate.toISOString(),
			})),
		},
	],
};
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead
			title={`${SITE_TITLE} — Embedded systems & React Native dev blog`}
			description={SITE_DESCRIPTION}
		/>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	</head>
	<body class="flex min-h-screen flex-col">
		<AmbientBackground />
		<Header />
		<main class="flex-1">
			<section class="mx-auto max-w-3xl px-4 pt-36 pb-16 md:px-6 md:pt-44">
				<Badge variant="secondary" className="mb-6">Welcome</Badge>
				<h1 class="text-4xl font-bold tracking-tighter text-foreground sm:text-5xl md:text-6xl">
					Hello, Fellow Developer!
				</h1>
				<p class="mt-4 text-lg font-medium text-foreground">
					Erroroverflow — practical debugging notes on embedded systems and React Native.
				</p>
				<div class="mt-8 max-w-2xl space-y-5 text-lg leading-relaxed text-muted-foreground">
					<p>
						Every post here starts with a real bug I hit and follows the trail it left behind —
						from flashing microcontrollers to React Native internals.
					</p>
					<p>
						If you find anything of use to you here or even remotely helpful consider me honored.
						Have fun and Happy Coding!
					</p>
				</div>
				<p class="mt-6 max-w-2xl text-xs leading-relaxed text-muted-foreground/70">
					Heads up: this blog has ads. Hosting and domains cost money and I am just trying to
					recover some of those costs. This self-hosting thing may be a hobby, but it is an
					expensive one for sure.
				</p>
				<div class="mt-10 flex flex-wrap items-center gap-3">
					<Button asChild className="rounded-full px-6">
						<a href="/blog">Read the Blog</a>
					</Button>
					<Button variant="outline" asChild className="rounded-full px-6">
						<a href="/about">About Me</a>
					</Button>
				</div>
			</section>

			{
				latest.length > 0 && (
					<section class="mx-auto w-full max-w-5xl px-4 pb-20 md:px-6">
						<div class="mb-6 flex items-end justify-between">
							<h2 class="text-2xl font-bold tracking-tight">Latest posts</h2>
							<a
								href="/blog"
								class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
							>
								View all
								<ArrowRight className="size-4" />
							</a>
						</div>
						<div class="grid gap-4 md:grid-cols-3">
							{latest.map((post) => (
								<PostCard post={post} />
							))}
						</div>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
