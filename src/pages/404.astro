---
import AmbientBackground from '../components/AmbientBackground.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { Button } from '@/components/ui/button';
import { SITE_TITLE } from '../consts';

export const prerender = true;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={SITE_TITLE} description="Page not found" />
		<title>404 - Page Not Found</title>
	</head>
	<body class="flex min-h-screen flex-col">
		<AmbientBackground />
		<Header />
		<main class="flex flex-1 flex-col items-center justify-center px-4 py-16 text-center">
			<div class="glass flex flex-col items-center rounded-3xl px-10 py-14 sm:px-16">
				<h1 class="text-7xl font-bold tracking-tighter text-muted-foreground sm:text-8xl">
					404
				</h1>
				<p class="mt-4 text-lg text-muted-foreground">Page not found</p>
				<Button asChild className="mt-8 rounded-full px-6">
					<a href="/">Back Home</a>
				</Button>
			</div>
		</main>
		<Footer />
	</body>
</html>
