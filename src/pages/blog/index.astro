---
import { getCollection } from 'astro:content';
import AmbientBackground from '../../components/AmbientBackground.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { Badge } from '@/components/ui/badge';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex min-h-screen flex-col">
		<AmbientBackground />
		<Header />
		<main class="flex-1">
			<section class="mx-auto w-full max-w-3xl px-4 pt-32 pb-20 md:px-6 md:pt-40">
				<div class="mb-10 flex items-center gap-3">
					<h1 class="text-3xl font-bold tracking-tighter text-foreground sm:text-4xl">Blog</h1>
					<Badge variant="secondary">
						{posts.length} post{posts.length !== 1 ? 's' : ''}
					</Badge>
				</div>

				<div class="grid gap-4">
					{posts.map((post) => <PostCard post={post} />)}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
