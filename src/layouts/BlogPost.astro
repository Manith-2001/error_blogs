---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AmbientBackground from '../components/AmbientBackground.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { Badge } from '@/components/ui/badge';
import '../styles/global.css';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="flex min-h-screen flex-col">
		<AmbientBackground />
		<Header />
		<main class="flex-1">
			<article>
				{
					heroImage && (
						<div class="mx-auto max-w-5xl px-4 pt-28 md:px-6 md:pt-32">
							<div class="glass overflow-hidden rounded-2xl p-1.5">
								<div class="aspect-[2/1] w-full overflow-hidden rounded-xl">
									<Image
										width={1020}
										height={510}
										src={heroImage}
										alt=""
										loading="eager"
										class="h-full w-full object-cover"
									/>
								</div>
							</div>
						</div>
					)
				}
				<div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
					<div class="space-y-5">
						<div class="flex flex-wrap items-center gap-2">
							<Badge variant="secondary" className="font-normal">
								<FormattedDate date={pubDate} />
							</Badge>
							{
								updatedDate && (
									<Badge variant="outline" className="font-normal">
										Updated <FormattedDate date={updatedDate} />
									</Badge>
								)
							}
						</div>
						<h1 class="text-3xl font-bold tracking-tighter text-foreground sm:text-4xl md:text-5xl">
							{title}
						</h1>
					</div>
					<div class="prose mt-10">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
