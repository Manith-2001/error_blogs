---
// Fixed ambient glow orbs behind the glass surfaces.
// Purely decorative — pointer-events none, sits under all content.
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
	<div
		class="absolute -top-40 left-1/2 h-[36rem] w-[60rem] -translate-x-1/2 rounded-full opacity-[0.13] blur-3xl"
		style="background: radial-gradient(closest-side, oklch(0.55 0.2 275), transparent)"
	>
	</div>
	<div
		class="absolute -bottom-48 -left-40 h-[32rem] w-[32rem] rounded-full opacity-[0.09] blur-3xl"
		style="background: radial-gradient(closest-side, oklch(0.6 0.14 195), transparent)"
	>
	</div>
	<div
		class="absolute -right-48 top-1/3 h-[30rem] w-[30rem] rounded-full opacity-[0.07] blur-3xl"
		style="background: radial-gradient(closest-side, oklch(0.55 0.18 320), transparent)"
	>
	</div>
</div>
