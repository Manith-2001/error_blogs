---
import type { CollectionEntry } from 'astro:content';
import { Badge } from '@/components/ui/badge';
import { ArrowUpRight } from 'lucide-react';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage } = post.data;
---

<a
	href={`/blog/${post.id}/`}
	class="group glass block rounded-2xl p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-foreground/25"
>
	<div class="flex items-start justify-between gap-4">
		<div class="min-w-0">
			<h3 class="font-bold tracking-tight text-foreground transition-colors group-hover:text-primary">
				{title}
			</h3>
			<p class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">{description}</p>
		</div>
		<ArrowUpRight
			className="mt-1 size-4 shrink-0 text-muted-foreground transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-foreground"
		/>
	</div>
	<div class="mt-4 flex items-center justify-between gap-4">
		<Badge variant="secondary" className="font-normal">
			<FormattedDate date={pubDate} />
		</Badge>
		{
			heroImage && (
				<img
					src={heroImage.src}
					alt=""
					class="hidden h-14 w-24 rounded-xl border border-border object-cover sm:block"
					loading="lazy"
				/>
			)
		}
	</div>
</a>
